# MailForge Environment Variables
# Copy to .env in each app, or use root .env for local dev

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://qwikmailer:qwikmailer_secret@localhost:5432/qwikmailer

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_REFRESH_SECRET=another_long_random_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── API ───────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# ─── SMTP (Maildev for local dev) ──────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Qwik Mailer
SMTP_FROM_EMAIL=noreply@qwikmailer.in

# ─── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_SECRET=nextauth_secret_change_me
NEXTAUTH_URL=http://localhost:3000

# ─── Email Verification ────────────────────────────────────
EMAIL_VERIFICATION_SECRET=email_verify_secret
EMAIL_VERIFICATION_EXPIRES_IN=24h

# ─── 2FA ───────────────────────────────────────────────────
TOTP_ISSUER=Qwik Mailer

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_FREE_PER_DAY=500
RATE_LIMIT_STARTER_PER_DAY=10000
RATE_LIMIT_GROWTH_PER_DAY=100000

# ─── AI (Google Gemini) ────────────────────────────────────
# Get your free key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
