{
  "name": "qwik-mailer",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev worker",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "redis:start": "./redis-server --port 6379 --daemonize yes --logfile redis.log",
    "redis:stop": "kill $(cat redis.pid 2>/dev/null) 2>/dev/null || true",
    "worker": "pnpm --filter @qwikmailer/api run worker"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
